# Streamlit
# Ignora o diretorio inteiro (secrets.toml mora aqui) menos o tema, que
# precisa vir junto no clone. O padrao e ".streamlit/*" e nao ".streamlit/":
# o git nao reinclui arquivo cujo diretorio pai foi excluido, entao com a
# barra sozinha o "!" abaixo nao teria efeito.
.streamlit/*
!.streamlit/config.toml

# IDE
.vscode/*
!.vscode/extensions.json

# SO
.DS_Store
Thumbs.db

# Gerador de scaffold: uso unico, mantido apenas localmente.
# Ele carrega uma copia integral de todos os arquivos do projeto em here-strings;
# versiona-lo criaria uma segunda fonte da verdade, que diverge silenciosamente
# do codigo real e sobrescreve o trabalho se for reexecutado.
create_project.ps1

